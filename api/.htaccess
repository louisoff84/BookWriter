Options -Indexes
RewriteEngine On

# Google authentication replaces password login/register.
RewriteRule ^auth/(google(?:/.*)?|login|register)$ google-auth.php [QSA,L]

# API served directly at the Plesk domain root.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]

<FilesMatch "^(init|google-auth)\.php$">
    Require all denied
</FilesMatch>

<FilesMatch "\.(sqlite|db|log)$">
    Require all denied
</FilesMatch>
