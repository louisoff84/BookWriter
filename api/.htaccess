Options -Indexes
RewriteEngine On

# API servie directement à la racine du domaine Plesk.
# Exemple: /auth/login, /books, /public/books, /google/callback
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]

<Files "init.php">
    Require all denied
</Files>

<FilesMatch "\.(sqlite|db|log)$">
    Require all denied
</FilesMatch>
