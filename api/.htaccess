Options -Indexes
RewriteEngine On

# Google authentication replaces password login/register.
RewriteRule ^auth/(google(?:/.*)?|login|register)$ google-auth.php [QSA,L]

# API served directly at the Plesk domain root.
# Route through router.php so .env is loaded before index.php.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ router.php [QSA,L]

<FilesMatch "^(init|env-loader)\.php$">
    Require all denied
</FilesMatch>

<FilesMatch "^(\.env|.*\.(sqlite|db|log))$">
    Require all denied
</FilesMatch>
